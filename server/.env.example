# ===========================================
# DATABASE CONNECTION STRINGS
# ===========================================

# Transaction pooler connection (port 6543)
# Used by Prisma Client for all database queries in our Fastify app
# This is a pooled connection that handles multiple concurrent requests efficiently
DATABASE_URL=""
# Direct database connection (port 5432)
# Used by Prisma CLI for migrations and schema changes
# This is a direct, non-pooled connection required for DDL operations (CREATE TABLE, ALTER, etc.)
DIRECT_URL=""

# ===========================================
# SUPABASE API CONFIGURATION
# ===========================================

# Supabase project's API endpoint
# This is the base URL for all Supabase API calls (auth, storage, realtime)
# ✅ Safe to expose in client-side code
SUPABASE_URL=""

# Publishable/Anonymous Key (client-side safe)
# Use this in the React Native mobile app for user authentication and public operations
# Protected by Row Level Security (RLS) policies - users can only access their own data
# ✅ Safe to expose in mobile app
SUPABASE_ANON_KEY=""
# Secret/Service Role Key (server-side ONLY)
# Use this ONLY in our Fastify backend for admin operations:
# - Verifying user JWT tokens
# - Uploading files to Supabase Storage
# - Operations that need to bypass Row Level Security
# ❌ NEVER expose in client code or commit to public repos
SUPABASE_SERVICE_ROLE_KEY=""

SHADOW_DATABASE_URL=""

# Server Configuration
NODE_ENV="development"
PORT=3000



