# ===========================================
# DATABASE CONNECTION STRINGS
# ===========================================

# Transaction pooler connection (port 6543)
# Used by Prisma Client for all database queries in our Fastify app
# This is a pooled connection that handles multiple concurrent requests efficiently
DATABASE_URL=""
# Direct database connection (port 5432)
# Used by Prisma CLI for migrations and schema changes
# This is a direct, non-pooled connection required for DDL operations (CREATE TABLE, ALTER, etc.)
DIRECT_URL=""

# ===========================================
# SUPABASE API CONFIGURATION
# ===========================================

# Supabase project's API endpoint
# This is the base URL for all Supabase API calls (auth, storage, realtime)
# ✅ Safe to expose in client-side code
SUPABASE_URL=""

# Publishable/Anonymous Key (client-side safe)
# Use this in the React Native mobile app for user authentication and public operations
# Protected by Row Level Security (RLS) policies - users can only access their own data
# ✅ Safe to expose in mobile app
SUPABASE_ANON_KEY=""
# Secret/Service Role Key (server-side ONLY)
# Use this ONLY in our Fastify backend for admin operations:
# - Verifying user JWT tokens
# - Uploading files to Supabase Storage
# - Operations that need to bypass Row Level Security
# ❌ NEVER expose in client code or commit to public repos
SUPABASE_SERVICE_ROLE_KEY=""

SHADOW_DATABASE_URL=""

# Server Configuration
NODE_ENV="development"
PORT=3000
# Number of days to retain deleted-account audit metadata and quarantined profile pictures
ACCOUNT_DELETION_RETENTION_DAYS=14
# ===========================================
# GEOCODING SERVICE CONFIGURATION
# ===========================================

# Contact email for OpenStreetMap Nominatim API
# 
# TODO: Add this before production launch
# 
# OpenStreetMap requires a contact email in the User-Agent header.
# Without it, they may ban our IP without warning if we exceed rate limits.
# 
# BEFORE LAUNCH:
# 1. Create a dedicated email: fyndmate.dev@gmail.com (or similar)
# 2. Uncomment and add the email below
# 3. Restart the server
# 
# See policy: https://operations.osmfoundation.org/policies/nominatim/
# 
# CONTACT_EMAIL="fyndmate.dev@gmail.com"

# ===========================================
# REDIS CONFIGURATION
# ===========================================

# Redis connection string for caching, rate limiting, and real-time features
# 
# SETUP INSTRUCTIONS:
# 1. Create free account at https://upstash.com/
# 2. Create a new Redis database (Regional, TLS enabled)
# 3. Copy the connection string (starts with rediss://)
# 4. Paste it below
# 
# Example: rediss://default:YOUR_PASSWORD@us1-sacred-fox-12345.upstash.io:6379
# 
# For local development, you can use Docker:
# docker run -d --name redis-dev -p 6379:6379 redis:7-alpine
# REDIS_URL="redis://localhost:6379"
# 
REDIS_URL=""
# TODO (deploy): set to your production Upstash Redis URL (rediss://...)
# TODO (deploy): set KEEPALIVE_URL in GitHub Actions secrets to your deployed /health/redis endpoint for keepalive
