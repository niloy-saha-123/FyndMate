generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String          @id @default(cuid())
  supabaseId       String          @unique
  email            String          @unique
  name             String
  profilePicture   String?
  bio              String?
  experience       String?
  skills           String[]
  interests        String[]
  commitment       String?
  githubUsername   String?         @unique
  githubData       Json?
  githubActivity   Json?
  // New location fields
  city             String?        // e.g. "San Francisco"
  country          String?        // e.g. "USA"
  latitude         Float?         // optional, kept for internal verification
  longitude        Float?         // optional, kept for internal verification
  locationSharing  String         @default("whileOpen") // "always" | "whileOpen" | "never"
  lastLocationAt   DateTime?      // timestamp of last successful location update
  locationSecret   String         @default(cuid()) // Random secret for HMAC signature verification
  timezone         String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  auditLogs        AuditLog[]      @relation("UserAuditLogs")
  matchesAsUser1   Match[]         @relation("User1Matches")
  matchesAsUser2   Match[]         @relation("User2Matches")
  sentMessages     Message[]       @relation("SentMessages")
  projects         Project[]
  likesReceived    Like[]          @relation("LikesReceived")
  likesMade        Like[]          @relation("LikesMade")
  blocksMade       Block[]         @relation("BlocksMade")
  blocksReceived   Block[]         @relation("BlocksReceived")

  // Safety & Moderation
  banned           Boolean         @default(false)
  banReason        String?
  bannedAt         DateTime?
  uploadSessions   UploadSession[] @relation("UserUploadSessions")

  @@index([supabaseId])
  @@index([githubUsername])
  @@index([createdAt])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  techStack   String[]
  githubUrl   String?
  liveUrl     String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Like {
  id        String   @id @default(cuid())
  likerId   String
  likedId   String
  liked     Boolean  // true=LIKE, false=PASS
  message   String?  // Required if liked=true (min 20 chars for Intro)
  status    String   @default("active")  // 'active', 'archived'
  createdAt DateTime @default(now())

  likedUser User     @relation("LikesReceived", fields: [likedId], references: [id], onDelete: Cascade)
  likerUser User     @relation("LikesMade", fields: [likerId], references: [id], onDelete: Cascade)

  @@unique([likerId, likedId])
  @@index([likerId, liked])
  @@index([likedId, status, liked]) // Critical for Likes Section query
}

model Match {
  id        String    @id @default(cuid())
  user1Id   String
  user2Id   String
  status    String    @default("active") // 'active', 'unmatched'
  createdAt DateTime  @default(now())
  user1     User      @relation("User1Matches", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User      @relation("User2Matches", fields: [user2Id], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([status])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Message {
  id        String    @id @default(cuid())
  matchId   String
  senderId  String
  content   String
  createdAt DateTime  @default(now())
  readAt    DateTime?
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender    User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@index([senderId])
  @@index([matchId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  action    String
  entity    String   @default("profile_picture")
  oldValue  String?
  newValue  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  status    String
  error     String?
  user      User     @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@index([userId, createdAt])
  @@index([status])
}

model UploadSession {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  userId      String
  uploadPath  String    @unique
  ipAddress   String
  userAgent   String?
  used        Boolean   @default(false)
  usedAt      DateTime?
  confirmedAt DateTime?
  user        User      @relation("UserUploadSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([uploadPath])
  @@index([used])
  @@index([expiresAt])
}
