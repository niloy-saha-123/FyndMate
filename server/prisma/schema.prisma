generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                          String                        @id @default(uuid())
  supabaseId                  String                        @unique
  email                       String                        @unique
  name                        String
  profilePicture              String?
  bio                         String?
  experience                  String?
  skills                      String[]
  interests                   String[]
  commitment                  String?
  githubUsername              String?                       @unique
  githubData                  Json?
  githubActivity              Json?
  timezone                    String
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  banned                      Boolean                       @default(false)
  banReason                   String?
  bannedAt                    DateTime?
  city                        String?
  country                     String?
  lastLocationAt              DateTime?
  latitude                    Float?
  locationSecret              String?                       @default(uuid())
  locationSharing             String                        @default("off")
  longitude                   Float?
  locationPermission          String?
  pushToken                   String?
  pushTokenUpdatedAt          DateTime?                     @db.Timestamp(6)
  location                    String?                       @default("Unknown")
  fullName                    String?
  birthDate                   DateTime?                     @db.Date
  gender                      String?
  onboardingCompleted         Boolean?                      @default(false)
  auditLogs                   AuditLog[]                    @relation("UserAuditLogs")
  blocksReceived              Block[]                       @relation("BlocksReceived")
  blocksMade                  Block[]                       @relation("BlocksMade")
  likesReceived               Like[]                        @relation("LikesReceived")
  likesMade                   Like[]                        @relation("LikesMade")
  matchesAsUser1              Match[]                       @relation("User1Matches")
  matchesAsUser2              Match[]                       @relation("User2Matches")
  MatchNotificationPreference MatchNotificationPreference[]
  sentMessages                Message[]                     @relation("SentMessages")
  projects                    Project[]
  uploadSessions              UploadSession[]               @relation("UserUploadSessions")

  @@index([supabaseId])
  @@index([githubUsername])
  @@index([createdAt])
}

model Project {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String
  techStack   String[]
  githubUrl   String?
  liveUrl     String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Like {
  id        String   @id @default(uuid())
  likerId   String
  likedId   String
  liked     Boolean
  message   String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  likedUser User     @relation("LikesReceived", fields: [likedId], references: [id], onDelete: Cascade)
  likerUser User     @relation("LikesMade", fields: [likerId], references: [id], onDelete: Cascade)

  @@unique([likerId, likedId])
  @@index([likerId, liked])
  @@index([likedId, status, liked])
  @@index([likerId])
  @@index([likedId])
}

model Match {
  id                          String                        @id @default(uuid())
  user1Id                     String
  user2Id                     String
  status                      String                        @default("active")
  createdAt                   DateTime                      @default(now())
  blockedBy                   String?
  user1                       User                          @relation("User1Matches", fields: [user1Id], references: [id], onDelete: Cascade)
  user2                       User                          @relation("User2Matches", fields: [user2Id], references: [id], onDelete: Cascade)
  MatchNotificationPreference MatchNotificationPreference[]
  messages                    Message[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([status])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Message {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId   String
  senderId  String
  content   String
  createdAt DateTime  @default(now())
  readAt    DateTime?
  editedAt  DateTime? @db.Timestamp(6)
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender    User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@index([senderId])
  @@index([matchId, readAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  action    String
  entity    String   @default("profile_picture")
  oldValue  String?
  newValue  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  status    String
  error     String?
  user      User     @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@index([userId, createdAt])
  @@index([status])
}

model UploadSession {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  userId      String
  uploadPath  String    @unique
  ipAddress   String
  userAgent   String?
  used        Boolean   @default(false)
  usedAt      DateTime?
  confirmedAt DateTime?
  user        User      @relation("UserUploadSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([uploadPath])
  @@index([used])
  @@index([expiresAt])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model MatchNotificationPreference {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  matchId   String
  userId    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)
  Match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([matchId, userId], map: "MatchNotificationPreference_unique")
  @@unique([matchId, userId], map: "unique_match_user_notification")
  @@index([matchId], map: "idx_match_notification_pref_match")
  @@index([userId], map: "idx_match_notification_pref_user")
}
