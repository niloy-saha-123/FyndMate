{
  "name": "fyndmate-server",
  "version": "1.0.0",
  "type": "module",
  "description": "FyndMate backend API server",
  "main": "dist/server.js",
  "scripts": {
    "// === DEVELOPMENT ===": "",
    "dev": "dotenv -e .env.local -- tsx watch src/server.ts",
    "dev:prod": "tsx watch src/server.ts",
    "dev:debug": "dotenv -e .env.local -- tsx watch --inspect src/server.ts",
    "// === BUILD & PRODUCTION ===": "",
    "build": "npm run clean && tsc",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "// === TYPE CHECKING ===": "",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "// === DATABASE - LOCAL (Safe for Development) ===": "",
    "db:local:push": "dotenv -e .env.local -- prisma db push",
    "db:local:studio": "dotenv -e .env.local -- prisma studio",
    "db:local:seed": "dotenv -e .env.local -- tsx scripts/test_matching_engine.ts",
    "db:local:setup": "npm install && npm run test:setup && npm run db:generate",
    "db:local:reset": "npx supabase db reset",
    "// === DATABASE - PRODUCTION (Use with Caution) ===": "",
    "db:prod:push": "prisma db push",
    "db:prod:studio": "prisma studio",
    "db:prod:migrate": "prisma migrate deploy",
    "// === DATABASE - SHARED ===": "",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "// === TESTING & UTILITIES ===": "",
    "token:local": "npx tsx scripts/get_test_token.ts",
    "clean": "rm -rf dist",
    "clean:all": "rm -rf dist node_modules",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "test:setup": "echo 'DATABASE_URL=\"postgresql://postgres:postgres@127.0.0.1:54322/postgres\"' > .env.test && echo 'DIRECT_URL=\"postgresql://postgres:postgres@127.0.0.1:54322/postgres\"' >> .env.test && dotenv -e .env.test -- prisma db push",
    "// === PRE-DEPLOYMENT ===": "",
    "prebuild": "npm run db:generate",
    "prestart:prod": "npm run db:prod:migrate"
  },
  "keywords": [
    "fastify",
    "api",
    "backend",
    "fyndmate"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^8.4.0",
    "@fastify/multipart": "^8.0.0",
    "@fastify/websocket": "^8.3.0",
    "@octokit/graphql": "^7.0.1",
    "@prisma/adapter-pg": "^5.22.0",
    "@prisma/client": "5.22.0",
    "@supabase/supabase-js": "^2.89.0",
    "axios": "^1.13.2",
    "express": "^5.2.1",
    "fastify": "^4.24.3",
    "ioredis": "^5.9.2",
    "pg": "^8.13.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.6.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.27",
    "cuid": "^3.0.0",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "prisma": "5.22.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16"
  }
}
