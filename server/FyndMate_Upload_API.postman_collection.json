{
    "info": {
        "name": "FyndMate - Profile Picture Upload API",
        "description": "Complete test suite for profile picture upload with security tests",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8080",
            "type": "string"
        },
        {
            "key": "jwtToken",
            "value": "YOUR_JWT_TOKEN_HERE",
            "type": "string"
        },
        {
            "key": "signedUrl",
            "value": "",
            "type": "string"
        },
        {
            "key": "uploadPath",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "✅ Happy Path Tests",
            "item": [
                {
                    "name": "1. Request Upload URL",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Response has signedUrl\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.signedUrl).to.exist;",
                                    "    pm.collectionVariables.set(\"signedUrl\", jsonData.signedUrl);",
                                    "});",
                                    "",
                                    "pm.test(\"Response has uploadPath\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.uploadPath).to.exist;",
                                    "    pm.collectionVariables.set(\"uploadPath\", jsonData.uploadPath);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"fileExtension\": \"jpg\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/upload/profile-picture/request",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "upload",
                                "profile-picture",
                                "request"
                            ]
                        }
                    }
                },
                {
                    "name": "2. Upload Image to Supabase",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "image/jpeg",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "file",
                            "file": {}
                        },
                        "url": {
                            "raw": "{{signedUrl}}",
                            "host": [
                                "{{signedUrl}}"
                            ]
                        },
                        "description": "Select a JPG image file from your computer"
                    }
                },
                {
                    "name": "3. Confirm Upload",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Response has publicUrl\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.publicUrl).to.exist;",
                                    "});",
                                    "",
                                    "pm.test(\"Success message\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.message).to.include(\"successfully\");",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"uploadPath\": \"{{uploadPath}}\",\n  \"idempotencyKey\": \"test-upload-123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/upload/profile-picture/confirm",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "upload",
                                "profile-picture",
                                "confirm"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "🔒 Security Tests",
            "item": [
                {
                    "name": "❌ No Auth Token (Should Fail)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status is 401\", function () {",
                                    "    pm.response.to.have.status(401);",
                                    "});",
                                    "",
                                    "pm.test(\"Error mentions authorization\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.error.toLowerCase()).to.include(\"authorization\");",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"fileExtension\": \"jpg\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/upload/profile-picture/request",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "upload",
                                "profile-picture",
                                "request"
                            ]
                        }
                    }
                },
                {
                    "name": "❌ Invalid Token (Should Fail)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status is 401\", function () {",
                                    "    pm.response.to.have.status(401);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer invalid-token-xyz123",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"fileExtension\": \"jpg\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/upload/profile-picture/request",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "upload",
                                "profile-picture",
                                "request"
                            ]
                        }
                    }
                },
                {
                    "name": "❌ Reuse Upload URL (Should Fail)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status is 403\", function () {",
                                    "    pm.response.to.have.status(403);",
                                    "});",
                                    "",
                                    "pm.test(\"Error mentions already used\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.error.toLowerCase()).to.include(\"used\");",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"uploadPath\": \"{{uploadPath}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/upload/profile-picture/confirm",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "upload",
                                "profile-picture",
                                "confirm"
                            ]
                        },
                        "description": "Run this AFTER completing a successful upload. Should fail with 'already used'."
                    }
                },
                {
                    "name": "❌ Wrong User's Path (Should Fail)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status is 403\", function () {",
                                    "    pm.response.to.have.status(403);",
                                    "});",
                                    "",
                                    "pm.test(\"Error mentions access denied\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.error.toLowerCase()).to.include(\"access\");",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"uploadPath\": \"different-user-id/123456-abc.jpg\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/upload/profile-picture/confirm",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "upload",
                                "profile-picture",
                                "confirm"
                            ]
                        },
                        "description": "Try to confirm upload for a different user's path"
                    }
                }
            ]
        },
        {
            "name": "ℹ️ Health Check",
            "item": [
                {
                    "name": "Server Health",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Server is healthy\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.status).to.eql(\"ok\");",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/health",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "health"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "❤️ Matching Engine",
            "item": [
                {
                    "name": "1. Get Discovery Feed",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Response has data array\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.data).to.be.an('array');",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/feed?limit=10",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "feed"
                            ],
                            "query": [
                                {
                                    "key": "limit",
                                    "value": "10"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "2. Send Like",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"likedId\": \"TARGET_USER_ID_HERE\",\n    \"liked\": true,\n    \"message\": \"Hey! This is a test message longer than 20 chars.\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/likes",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "likes"
                            ]
                        }
                    }
                },
                {
                    "name": "3. Get Matches",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{jwtToken}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/matches",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "matches"
                            ]
                        }
                    }
                }
            ]
        }
    ]
}