# EAS upload ignore rules (separate from .gitignore)
# Keep native folders (/android, /ios) included for cloud builds.

# dependencies
node_modules/

# Expo cache/output
.expo/
dist/
web-build/
expo-env.d.ts

# Native build artifacts/secrets
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
