{
  "expo": {
    "name": "FyndMate",
    "slug": "FyndMate",
    "scheme": "fyndmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fyndMate.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FyndMate uses your location to show your city and country on your profile.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "FyndMate uses your location in the background to keep your city and country up to date.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fyndMate.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "1b2fa64e-1f8e-4bda-b345-83c62d9929f8"
      }
    },
    "plugins": [
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": { "light": "#6366F1", "dark": "#6366F1" },
              "textColorPrimary": { "light": "#000000", "dark": "#FFFFFF" }
            }
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow FyndMate to access your location in the background to keep your city and country updated.",
          "locationWhenInUsePermission": "Allow FyndMate to access your location while using the app to show your city and country.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ]
  }
}
